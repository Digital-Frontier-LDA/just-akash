# Akash Console API key
# Get yours at: https://console.akash.network -> Settings -> API Keys
AKASH_API_KEY=your-api-key-here

# Preferred (vetted) Akash providers (comma-separated). Cheapest preferred wins when bidding.
# Leave empty to accept bids from ANY provider.
AKASH_PROVIDERS=akash1hgulk6aekakqzc0v6wukrd3dy9n90f5gkl4ezk,akash1aaul837r7en7hpk9wv2svg8u78fdq0t2j2e82z,akash1z9nr23cgweu45g2jktfx95v7g2xp8qlsa3ys2x,akash1jk3v62a5kf7m4ee0lqpagwvvjyw6e3vnl5ggr9

# Backup Akash providers: NOT read from the environment any more. The backup tier is only what a
# deploy names with --backup-provider (repeatable). Kept here empty so old .env files are visibly
# inert; a value set here is ignored with a warning.
AKASH_PROVIDERS_BACKUP=

# SSH public key(s) for Akash deployments (used by cpu-backtest-ssh.yaml)
# Supports multiple keys separated by newlines
SSH_PUBKEY="ssh-ed25519 AAAA... your-key-comment"

# Console API URL (default: https://console-api.akash.network)
# AKASH_CONSOLE_URL=https://console-api.akash.network
