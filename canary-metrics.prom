# HELP akash_canary_deployed 1 if this provider has a canary deployment with an ingress to scrape at all. 0 means no canary EXISTS -- not that one is broken.
# TYPE akash_canary_deployed gauge
akash_canary_deployed{provider="alphavps"} 1
