akash_canary_deployed{provider="alphavps"} 1
akash_canary_deployed{provider="hetzner_hel"} 1
akash_canary_deployed{provider="onidc"} 1
# HELP akash_canary_active_deployments Providers with a live canary deployment. 0 means the canary fleet is not running, so every per-provider signal above it is measuring nothing.
# TYPE akash_canary_active_deployments gauge
akash_canary_active_deployments 3
