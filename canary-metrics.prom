# HELP akash_canary_uptime_seconds Seconds since the canary process started (resets on restart).
# TYPE akash_canary_uptime_seconds gauge
# HELP akash_canary_egress_ok_total Successful outbound HTTP probes from inside the deployment.
# TYPE akash_canary_egress_ok_total counter
# HELP akash_canary_egress_fail_total FAILED outbound HTTP probes from inside — the workload could not reach out.
# TYPE akash_canary_egress_fail_total counter
# HELP akash_canary_dns_ok_total Successful DNS resolutions from inside the deployment.
# TYPE akash_canary_dns_ok_total counter
# HELP akash_canary_dns_fail_total FAILED DNS resolutions from inside the deployment.
# TYPE akash_canary_dns_fail_total counter
# HELP akash_canary_disk_write_seconds fsync latency for a 4KiB write as the workload feels it (-1 = unusable).
# TYPE akash_canary_disk_write_seconds gauge
# HELP akash_canary_sched_jitter_seconds How late the probe tick fired — CPU contention from the customer's side.
# TYPE akash_canary_sched_jitter_seconds gauge
# HELP akash_canary_scrape_seconds Time to fetch the canary's /metrics over its public ingress.
# TYPE akash_canary_scrape_seconds gauge
