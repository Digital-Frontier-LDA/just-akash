# Canary telemetry — persistent per-provider deployments, measured from INSIDE.
# Generated by canary/collect.py. Do not hand-edit.
# HELP akash_canary_reachable 1 if the provider served the canary's /metrics on its ingress at the last check. This is the customer-visible up/down.
# TYPE akash_canary_reachable gauge
akash_canary_reachable{provider="alphavps"} 1
akash_canary_reachable{provider="hetzner_hel"} 1
akash_canary_reachable{provider="onidc"} 1
# HELP akash_canary_restarts_total Container restarts observed via boot_id change within the SAME lease. Excludes lease replacements.
# TYPE akash_canary_restarts_total counter
akash_canary_restarts_total{provider="alphavps"} 0
akash_canary_restarts_total{provider="hetzner_hel"} 0
akash_canary_restarts_total{provider="onidc"} 0
# HELP akash_canary_lease_replacements_total Times the lease had to be recreated (dseq changed) — a deployment the provider closed or that lapsed.
# TYPE akash_canary_lease_replacements_total counter
akash_canary_lease_replacements_total{provider="alphavps"} 5
akash_canary_lease_replacements_total{provider="hetzner_hel"} 5
akash_canary_lease_replacements_total{provider="onidc"} 5
